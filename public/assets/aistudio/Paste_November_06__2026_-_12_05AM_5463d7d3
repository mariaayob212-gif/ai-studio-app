      mut(s=>{s.characters=s.characters.filter(c=>c.id!==f.id);const ids=s.chats.filter(c=>c.charId===f.id).map(c=>c.id);s.chats=s.chats.filter(c=>c.charId!==f.id);s.phoneLogs=s.phoneLogs.filter(l=>!ids.includes(l.chatId))});
