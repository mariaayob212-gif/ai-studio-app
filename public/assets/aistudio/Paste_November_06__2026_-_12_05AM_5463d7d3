/* ---------- Rich Text Renderer ---------- */
function Rich({text}){
  const parts=strip(text||"").split(/(\*[^*]+\*|"[^"]+"|“[^”]+”)/g).filter(Boolean);
  return (
    <span className="leading-relaxed whitespace-pre-wrap">
      {parts.map((p,i)=>p[0]==="*"&&p.length>1&&p.endsWith("*")
        ?<em key={i} style={{color:"var(--silver)"}} className="italic">{p.slice(1,-1)}</em>
        :/^["“]/.test(p)
          ?<b key={i} style={{color:"var(--ivory)"}} className="font-semibold">{p}</b>
          :<span key={i}>{p.replace(/\*/g,"")}</span>)}
    </span>
  );
}

