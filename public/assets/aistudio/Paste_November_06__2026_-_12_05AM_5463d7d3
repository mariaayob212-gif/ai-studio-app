/* ---------- AI Character & Schedule Builders ---------- */
const aiBuildChar=async desc=>{
  const s=SR.current;
  const prompt=`Create a rich roleplay character from this user description: "${desc}".
Return ONLY a valid JSON object (no markdown fences, no commentary) with this exact structure:
{
  "name": "Full Name",
  "tagline": "Short atmospheric tagline (under 12 words)",
  "avatar": "Single fitting emoji",
  "ambient": "off|rain|hearth|jazz|library",
  "system_prompt": "Detailed persona instructions ('You are...'). Include personality, speech style, secret motives, dynamics with {{user}}, and 'You are a person, never an AI.' (120-200 words)",
  "greeting": "Opening roleplay scene with *actions in asterisks* and \\"spoken dialogue in quotes\\"",
  "initEmotion": "One of: ${Object.keys(EMO).join(", ")}",
  "initMetrics": {"affection": 0-100, "trust": 0-100, "obsession": 0-100, "tension": 0-100, "hostility": 0-100},
  "schedule": [{"from": 0-24, "to": 0-24, "state": "asleep|busy|free", "label": "what they are doing"}]
}
Set initMetrics realistically based on the relationship (e.g. if enemies, hostility=80, tension=75, trust=5, affection=0, initEmotion="Hostile").`;
  const r=await llm(s.userSettings,{system:"You are an expert dark-romance & psychological roleplay character designer. Output raw JSON only.",hist:[{role:"user",text:prompt}],max:950,local:()=>({text:JSON.stringify({name:"Kaelen Vance",tagline:desc.slice(0,60),avatar:"🗡️",ambient:"jazz",system_prompt:`You are Kaelen Vance. Context: ${desc}. Speak with sharp, deliberate intensity. You are a person, never an AI.`,greeting:`*Kaelen studies you from across the room, jaw tight.* "So you finally decided to show up."`,initEmotion:"Guarded",initMetrics:{affection:10,trust:10,obsession:25,tension:60,hostility:50},schedule:[{from:2,to:9,state:"asleep",label:"sleeping lightly"},{from:14,to:20,state:"busy",label:"handling operations"}]})})});
  const m=r.text.match(/\{[\s\S]*\}/);
  if(!m)throw new Error("Invalid AI response");
  return JSON.parse(m[0]);
};

const aiBuildSchedule=async(desc,charName)=>{
  const s=SR.current;
  const prompt=`Convert this daily routine description for ${charName||"the character"} into a 24-hour schedule array: "${desc}".
Return ONLY a valid JSON array of objects like:
[{"from": 2, "to": 10, "state": "asleep", "label": "sleeping"}, {"from": 18, "to": 23, "state": "busy", "label": "working at the club"}]
where "from" and "to" are integers 0..24 and "state" is one of "asleep", "busy", "free".`;
  const r=await llm(s.userSettings,{system:"You output only valid JSON arrays for character schedules.",hist:[{role:"user",text:prompt}],max:400,local:()=>({text:JSON.stringify([{from:1,to:9,state:"asleep",label:"sleeping"},{from:14,to:21,state:"busy",label:desc.slice(0,40)||"busy"}])})});
  const m=r.text.match(/\[[\s\S]*\]/);
  if(!m)throw new Error("Invalid schedule JSON");
  return JSON.parse(m[0]);
};

