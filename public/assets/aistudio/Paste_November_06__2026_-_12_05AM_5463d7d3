      rec.onresult=e=>{const tx=e.results?.[0]?.[0]?.transcript||"";setV(prev=>(prev?prev+" ":"")+tx);};
      rec.onerror=()=>setListening(false);
      rec.onend=()=>setListening(false);
      recRef.current=rec;rec.start();
    }catch(e){setListening(false);}
  };

  return (
    <div className="fixed bottom-0 inset-x-0 z-40 px-3 pt-2" style={{paddingBottom:"calc(env(safe-area-inset-bottom,0px) + .65rem)"}}>
      <div className="max-w-2xl mx-auto relative">
