const voice=async(cid,lines,say)=>{
  const s=SR.current,chat=s.chats.find(c=>c.id===cid),char=s.characters.find(c=>c.id===chat.charId);
  const hist=[...lines.map(l=>({role:l.who==="user"?"user":"assistant",text:l.text}))];
  if(!hist.length||hist[hist.length-1].role!=="user")hist.push({role:"user",text:say});
  if(hist[0].role!=="user")hist.unshift({role:"user",text:"(call connects)"});
  const r=await llm(s.userSettings,{system:sys(char,chat)+"\nThis is a live voice call. Speak 1-3 short sentences. No actions, no asterisks.",hist,max:140,local:()=>localMuse(char,say,chat.metrics,true)});
  const tx=strip(r.text).replace(/\*/g,"");
  speak(tx,char.voiceId);
  return tx;
};

const speak=async(txt,vid)=>{
  txt=strip(txt).replace(/\*[^*]*\*/g,"").trim();if(!txt)return;
  const k=decKey(SR.current.userSettings.elevenKey);
  if(k){
    try{
      const r=await fetch("https://api.elevenlabs.io/v1/text-to-speech/"+(vid||"21m00Tcm4TlvDq8ikWAM"),{method:"POST",headers:{"xi-api-key":k,"Content-Type":"application/json"},body:JSON.stringify({text:txt,model_id:"eleven_multilingual_v2"})});
      if(!r.ok)throw 0;
      new Audio(URL.createObjectURL(await r.blob())).play();
      return;
    }catch(e){}
  }
  try{speechSynthesis.speak(new SpeechSynthesisUtterance(txt));}catch(e){}
};

