  const [v,setV]=useState(""),[q,setQ]=useState(false),[showLen,setShowLen]=useState(false),[listening,setListening]=useState(false);
  const recRef=useRef(null);
  const go=()=>{if(!v.trim()||gen)return;send(v.trim());setV("")};
  const lenIdx=ch.len??3;
  const labels=["whisper","brief","chatLen","balanced","scene","epic"];

  const toggleMic=()=>{
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SR)return;
    if(listening){
      try{recRef.current?.stop();}catch(e){}
      setListening(false);
      return;
    }
