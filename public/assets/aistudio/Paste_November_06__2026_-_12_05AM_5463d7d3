          <div className="flex gap-1 text-[11px] flex-wrap">
            {labels.map((k,i)=>(
              <button key={k} type="button" onClick={()=>{mut(s=>{s.chats.find(c=>c.id===chatId).len=i});setShowLen(false);}}
                className="px-2.5 py-1 rounded-full transition"
                style={{color:lenIdx===i?"#0b0b0d":"var(--ivory)",background:lenIdx===i?"var(--gold)":"rgba(255,255,255,.06)",fontWeight:lenIdx===i?600:400}}>
                {t(k)}
              </button>
            ))}
          </div>
