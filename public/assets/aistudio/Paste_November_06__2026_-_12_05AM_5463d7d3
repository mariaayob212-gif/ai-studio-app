};

const cont=async(mid,baseOverride)=>{
  const {s,chat,char}=ctxOf();const lv=LEN[chat.len]??LEN[3];
  const i=chat.messages.findIndex(m=>m.id===mid),m0=chat.messages[i],vi=m0.idx,base=baseOverride??m0.variants[vi];
  ABORT=new AbortController();setGen(mid);
