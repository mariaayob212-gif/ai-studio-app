const PLAB={gemini:"Gemini",openrouter:"OpenRouter",deepseek:"DeepSeek",ollama:"Ollama (local)",custom:"Custom (OpenAI-compatible)"};
const maskKey=k=>{const raw=decKey(k);return raw?raw.slice(0,4)+"•".repeat(12):"—"};

function SettingsView(){
  const {S,mut,setView,t,setConfirm,exportBackup,importBackup,setProfile,notify,orStats,orLoading,refreshOrBalance}=useCtx();
  const u=S.userSettings;
  const set=(k,v)=>mut(s=>{s.userSettings[k]=k==="elevenKey"?encKey(v):v});
  const keys=u.apiKeys||[];
  const [nk,setNk]=useState({name:"",key:"",provider:"openrouter",model:PRE.openrouter.m,baseUrl:""});
  const [fwInp,setFwInp]=useState("");
  const [edPrompt,setEdPrompt]=useState(null);

  const addKey=()=>{
    const key=nk.key.trim();if(!key&&nk.provider!=="ollama"){notify(t("keyNeeded"));return}
    const e={id:uid(),name:nk.name.trim()||(PLAB[nk.provider]+" key"),key:encKey(key),provider:nk.provider,model:nk.model.trim(),baseUrl:nk.baseUrl.trim()};
    mut(s=>{s.userSettings.apiKeys=[...(s.userSettings.apiKeys||[]),e];if(!s.userSettings.activeKeyId)s.userSettings.activeKeyId=e.id});
    setNk({name:"",key:"",provider:nk.provider,model:nk.model,baseUrl:""});
    notify(t("keyAdded"));
  };

  const delKey=k=>setConfirm({title:k.name,body:t("delKeyQ"),actions:[{label:t("del"),danger:true,fn:()=>mut(s=>{const L=(s.userSettings.apiKeys||[]).filter(x=>x.id!==k.id);s.userSettings.apiKeys=L;if(s.userSettings.activeKeyId===k.id)s.userSettings.activeKeyId=L[0]?.id||""})}]});
  const F=({k,l,type="text",ph})=>{const val=k==="elevenKey"?decKey(u[k]):(u[k]??"");return <label className="block text-xs text-neutral-400">{l}<input type={type} placeholder={ph} className="inp mt-1" value={val} onChange={e=>set(k,type==="number"?Math.max(0,+e.target.value||0):e.target.value)}/></label>};

  const cps=u.customPrompts||DEFAULT_PROMPTS;
  const activePrompt=cps.find(p=>p.id===u.activePromptId);
  const savePrompt=()=>{
    if(!edPrompt?.name?.trim())return;
    mut(s=>{
      const list=s.userSettings.customPrompts||[];
      const idx=list.findIndex(x=>x.id===edPrompt.id);
      if(idx<0)list.push(edPrompt);else list[idx]=edPrompt;
      s.userSettings.activePromptId=edPrompt.id;
    });
    setEdPrompt(null);
  };
  const delPrompt=id=>mut(s=>{
    s.userSettings.customPrompts=(s.userSettings.customPrompts||[]).filter(x=>x.id!==id);
    if(s.userSettings.activePromptId===id)s.userSettings.activePromptId="";
  });

  const fwords=u.forbiddenWords||[];
  const addFw=()=>{
    const w=fwInp.trim();if(!w||fwords.length>=10||fwords.includes(w))return;
    mut(s=>{s.userSettings.forbiddenWords=[...(s.userSettings.forbiddenWords||[]),w]});
    setFwInp("");
  };

  return (
    <div className="max-w-md mx-auto px-4 pt-5 pb-16 rise space-y-4">
      <div className="flex items-center justify-between"><h1 className="serif text-3xl gold">{t("settings")}</h1><button className="btn" onClick={()=>setView("home")}>‹ {t("back")}</button></div>

      {/* Instructions: Custom Prompt, Prefill & Forbidden Words */}
      <div className="glass rounded-3xl p-4 space-y-3">
        <div className="serif gold text-lg">📜 {t("instructions")}</div>

        <div className="space-y-2">
          <div className="flex items-center justify-between text-xs text-neutral-400">
            <span>{t("customPrompt")}</span>
            <button type="button" className="gold hover:underline" onClick={()=>setEdPrompt({id:uid(),name:"",text:""})}>＋ {t("newPrompt")}</button>
          </div>
          <select className="inp" style={{colorScheme:"dark"}} value={u.activePromptId||""} onChange={e=>set("activePromptId",e.target.value)}>
            <option value="">{t("noCustomPrompt")}</option>
            {cps.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}
          </select>
          {activePrompt&&!edPrompt&&<div className="rounded-2xl p-3 bg-black/30 border border-white/10 text-xs space-y-2">
            <div className="text-neutral-300 leading-relaxed line-clamp-3">{activePrompt.text}</div>
            <div className="flex gap-2 justify-end">
              <button type="button" className="btn" onClick={()=>setEdPrompt({...activePrompt})}>✎ {t("edit")}</button>
              {cps.length>1&&<button type="button" className="btn danger" onClick={()=>delPrompt(activePrompt.id)}>{t("del")}</button>}
            </div>
          </div>}
          {edPrompt&&<div className="rounded-2xl p-3 bg-black/40 border border-[var(--gold)]/40 space-y-2">
            <input className="inp text-xs" placeholder={t("promptName")} value={edPrompt.name} onChange={e=>setEdPrompt({...edPrompt,name:e.target.value})}/>
            <textarea rows={4} className="inp text-xs" placeholder={t("promptBody")} value={edPrompt.text} onChange={e=>setEdPrompt({...edPrompt,text:e.target.value})}/>
            <div className="flex gap-2 justify-end">
              <button type="button" className="btn" onClick={()=>setEdPrompt(null)}>{t("cancel")}</button>
              <button type="button" className="btn on" onClick={savePrompt}>{t("save")}</button>
            </div>
          </div>}
        </div>

        <div className="pt-2 border-t border-white/10 space-y-2">
          <div className="flex items-center justify-between">
            <div>
              <div className="text-xs font-medium">{t("prefill")}</div>
              <div className="text-[11px] text-neutral-500">{t("prefillDesc")}</div>
            </div>
            <input type="checkbox" className="w-4 h-4 accent-[var(--gold)]" checked={!!u.prefillOn} onChange={e=>set("prefillOn",e.target.checked)}/>
          </div>
          {u.prefillOn&&<input className="inp text-xs" placeholder={t("prefillText")} value={u.prefillText||""} onChange={e=>set("prefillText",e.target.value)}/>}
        </div>

        <div className="pt-2 border-t border-white/10 space-y-2">
          <div className="flex items-center justify-between text-xs text-neutral-400">
            <span>{t("forbiddenWords")}</span>
            <span className="gold font-mono">{fwords.length}/10</span>
          </div>
          <div className="flex gap-1.5">
            <input className="inp !py-1.5 text-xs" placeholder={t("forbiddenPh")} value={fwInp} onChange={e=>setFwInp(e.target.value)} onKeyDown={e=>e.key==="Enter"&&addFw()}/>
            <button type="button" className="btn on" disabled={fwords.length>=10||!fwInp.trim()} onClick={addFw}>＋</button>
          </div>
          {fwords.length>0&&<div className="flex flex-wrap gap-1.5 pt-1">
            {fwords.map((w,i)=>(
              <span key={i} className="text-xs px-2.5 py-1 rounded-full bg-white/10 flex items-center gap-1.5">
                <span>{w}</span>
                <button type="button" className="text-red-400 hover:text-white" onClick={()=>mut(s=>{s.userSettings.forbiddenWords=s.userSettings.forbiddenWords.filter((_,j)=>j!==i)})}>✕</button>
              </span>
            ))}
          </div>}
        </div>
      </div>

      {/* Multi-Key Vault + OpenRouter Live Balance */}
      <div className="glass rounded-3xl p-4 space-y-3">
        <div className="flex items-center justify-between">
          <div className="serif gold text-lg">🔐 {t("vault")}</div>
          {keys.some(k=>k.provider==="openrouter")&&<button type="button" className="btn !text-[11px]" disabled={orLoading} onClick={refreshOrBalance}>{orLoading?"…":"↻ "+t("checkBal")}</button>}
        </div>

        {orStats&&<div className="rounded-2xl p-3 bg-black/40 border border-[var(--gold)]/35 flex items-center justify-between text-xs">
          <div>
            <div className="text-neutral-400 text-[11px]">💳 {t("orBalance")}</div>
            <div className="text-lg font-mono gold font-semibold mt-0.5">{orStats.remaining!==null?`$${orStats.remaining.toFixed(4)}`:t("unlimited")}</div>
          </div>
          <div className="text-end text-[11px] text-neutral-400 space-y-0.5">
            {orStats.usage!==null&&<div>{t("used")}: <span className="text-neutral-200 font-mono">${orStats.usage.toFixed(4)}</span></div>}
            {orStats.limit!==null&&<div>Limit: <span className="text-neutral-200 font-mono">${orStats.limit.toFixed(2)}</span></div>}
          </div>
        </div>}

        <div className="space-y-2">
          {keys.length===0&&<p className="text-[11px] text-neutral-500">{t("noKeys")}</p>}
          {keys.map(k=>{
            const on=k.id===u.activeKeyId;
            return (
              <div key={k.id} className="rounded-2xl p-3 flex items-center gap-2 flex-wrap" style={{background:"rgba(255,255,255,.03)",border:on?"1.5px solid var(--gold)":"1px solid rgba(255,255,255,.08)"}}>
                <div className="flex-1 min-w-[130px]">
                  <div className="text-sm truncate" style={{color:on?"var(--gold)":undefined}}>{k.name}</div>
                  <div className="text-[11px] text-neutral-500 truncate">{PLAB[k.provider]||k.provider} · {k.model||(PRE[k.provider]||PRE.custom).m}</div>
                  <div className="text-[11px] text-neutral-400 font-mono">{maskKey(k.key)}</div>
                </div>
                <button className={"btn "+(on?"on":"")} onClick={()=>set("activeKeyId",k.id)}>{on?"● "+t("active"):"○ "+t("setActive")}</button>
                <button className="btn danger" onClick={()=>delKey(k)}>{t("del")}</button>
              </div>
            );
          })}
        </div>

        <div className="space-y-2 pt-3 border-t border-white/10">
          <div className="text-xs text-neutral-400">{t("addKey")}</div>
          <input className="inp" placeholder={t("keyName")} value={nk.name} onChange={e=>setNk({...nk,name:e.target.value})}/>
          <input type="password" autoComplete="off" className="inp" placeholder={t("keyStr")} value={nk.key} onChange={e=>setNk({...nk,key:e.target.value})}/>
          <select className="inp" style={{colorScheme:"dark"}} value={nk.provider} onChange={e=>setNk({...nk,provider:e.target.value,model:(PRE[e.target.value]||PRE.custom).m})}>
            {Object.keys(PRE).map(p=><option key={p} value={p}>{PLAB[p]}</option>)}
          </select>
          {nk.provider==="custom"&&<input className="inp" placeholder="https://…/v1" value={nk.baseUrl} onChange={e=>setNk({...nk,baseUrl:e.target.value})}/>}

          {/* Model Preset Datalist / Select */}
          <div className="space-y-1">
            <input list="model-presets" className="inp" placeholder={t("model")} value={nk.model} onChange={e=>setNk({...nk,model:e.target.value})}/>
            <datalist id="model-presets">
              {(MODEL_LIST[nk.provider]||[]).map(m=><option key={m} value={m}/>)}
            </datalist>
          </div>

          <button className="btn on w-full !py-2" onClick={addKey}>＋ {t("addKey")}</button>
        </div>
        <p className="text-[11px] text-neutral-500">{t("engine")}</p>
        {F({k:"elevenKey",l:t("elKey"),type:"password"})}
      </div>

      {/* Theme Switcher */}
      <div className="glass rounded-3xl p-4 space-y-3">
        <div className="serif gold text-lg">🎨 {t("theme")}</div>
        <div className="grid grid-cols-2 gap-2">
          {Object.entries(THEMES).map(([k,th])=>{
            const on=(u.theme||"gold")===k;
            return (
              <button key={k} type="button" onClick={()=>set("theme",k)} className="rounded-2xl p-2.5 flex items-center gap-2.5 text-left transition" style={{background:th.onyx,border:on?`2px solid ${th.gold}`:"1px solid rgba(255,255,255,.12)"}}>
                <span className="w-5 h-5 rounded-full shrink-0" style={{background:th.gold,boxShadow:`0 0 10px ${th.gold}`}}/>
                <span className="text-xs font-medium truncate" style={{color:th.ivory}}>{u.language==="ar"?th.nameAr:th.nameEn}</span>
              </button>
            );
          })}
        </div>
      </div>

      <div className="glass rounded-3xl p-4 space-y-3">
        <div className="text-xs text-neutral-400">{t("language")}</div>
        <div className="flex gap-2">{[["en","English"],["ar","العربية"]].map(([k,l])=><button key={k} className={"btn "+(u.language===k?"on":"")} onClick={()=>set("language",k)}>{l}</button>)}</div>
        <div className="text-xs text-neutral-400">{t("timeMode")}</div>
        <div className="flex gap-2 flex-wrap">{["auto","day","night"].map(k=><button key={k} className={"btn "+(u.timeMode===k?"on":"")} onClick={()=>set("timeMode",k)}>{t(k)}</button>)}</div>
        {F({k:"followUpSec",l:t("followUp"),type:"number"})}
      </div>

      <div className="glass rounded-3xl p-4 space-y-3">
        <button className="btn on w-full !py-2" onClick={()=>setProfile(true)}>👤 {t("myPersonas")}</button>
      </div>

      <div className="glass rounded-3xl p-4 space-y-3">
        <div className="serif gold text-lg">{t("genp")}</div>
        {[["temp",t("temp"),0,2,.1,1],["contextLimit",t("ctxWindow"),6,60,2,24]].map(([k,l,mn,mx,st,df])=>(
          <label key={k} className="block text-xs text-neutral-400">{l}: <b className="gold">{u[k]??df}</b>
            <input type="range" min={mn} max={mx} step={st} value={u[k]??df} onChange={e=>set(k,+e.target.value)}/>
          </label>
        ))}
      </div>

      <div className="glass rounded-3xl p-4 space-y-3">
        <div className="text-xs text-neutral-400">{t("backup")}</div>
        <div className="flex gap-2 flex-wrap">
          <button className="btn on" onClick={exportBackup}>{t("exportB")}</button>
          <label className="btn cursor-pointer">{t("importB")}<input type="file" accept="application/json,.json" className="hidden" onChange={importBackup}/></label>
        </div>
      </div>

      <button className="btn danger" onClick={()=>setConfirm({title:t("reset"),body:t("resetQ"),actions:[{label:t("reset"),danger:true,fn:()=>mut(s=>{const n=seed();n.userSettings=s.userSettings;Object.assign(s,n)})}]})}>{t("reset")}</button>
    </div>
  );
}

function Shell(){
  const {view,editing}=useCtx();
  return (
    <>
      <div key={view}>
        {view==="home"&&<HomeView/>}
        {view==="chat"&&<ChatView/>}
        {view==="settings"&&<SettingsView/>}
      </div>
      <CharEditor key={editing?.id||"none"}/>
      <ProfileModal/>
      <Confirm/>
    </>
  );
}

class Boundary extends React.Component{
  constructor(p){super(p);this.state={e:null}}
  static getDerivedStateFromError(e){return{e}}
  render(){
    return this.state.e?(
      <div className="min-h-screen grid place-items-center p-6 text-center">
        <div className="glass rounded-3xl p-6 max-w-sm">
          <p className="serif text-2xl gold mb-2">Something broke</p>
          <p className="text-xs text-neutral-400 mb-4 break-words">{String(this.state.e.message||this.state.e)}</p>
          <button className="btn on" onClick={()=>this.setState({e:null})}>Retry</button>
        </div>
      </div>
    ):this.props.children;
  }
}

ReactDOM.createRoot(document.getElementById("root")).render(<Boundary><Provider><Shell/></Provider></Boundary>);
</script></body></html>