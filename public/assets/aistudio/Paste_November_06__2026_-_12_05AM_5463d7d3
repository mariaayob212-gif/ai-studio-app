function CallsApp(){
  const {S,chatId,t,mut,voice,SR}=useCtx();
  const [call,setCall]=useState(null),[sec,setSec]=useState(0),[inp,setInp]=useState(""),[wait,setWait]=useState(false);
  const ch=S.chats.find(c=>c.id===chatId),char=S.characters.find(c=>c.id===ch.charId);
  useEffect(()=>{if(call?.status!=="live")return;const i=setInterval(()=>setSec(x=>x+1),1000);return()=>clearInterval(i)},[call?.status]);
  useEffect(()=>()=>{try{speechSynthesis.cancel()}catch(e){}},[]);

  const log=(text,dur,tr)=>mut(s=>{s.phoneLogs.push({id:uid(),chatId,type:"call",from:"user",text,dur,tr,ts:Date.now()});bumpMeta(s,chatId,text==="completed"?{affection:1,trust:1,tension:-1}:{tension:1})});
  const dial=()=>{
    setCall({status:"ringing",lines:[]});setSec(0);sfxRing();
    setTimeout(async()=>{
      const s=SR.current;
      if(availability(s.chats.find(c=>c.id===chatId),s.userSettings).busy){setCall({status:"missed",lines:[]});log("missed",0);return}
      setCall({status:"live",lines:[]});
      const l=await voice(chatId,[],"(the call connects — answer it)");
      setCall(c=>c&&{...c,lines:[{who:"char",text:l}]});
    },2200);
  };

  const say=async()=>{
    if(!inp.trim()||wait)return;
    const lines=[...call.lines,{who:"user",text:inp}];
    setCall({...call,lines});const q=inp;
    mut(s=>bumpMeta(s,chatId,SubtleMoodOf(q)));
    setInp("");setWait(true);
    const l=await voice(chatId,lines,q);
    setWait(false);
    setCall(c=>c&&{...c,lines:[...lines,{who:"char",text:l}]});
  };

  const hang=()=>{try{speechSynthesis.cancel()}catch(e){}if(call.status==="live")log("completed",sec,call.lines.map(l=>(l.who==="user"?"User: ":"You: ")+l.text).join(" | ").slice(0,400));setCall(null)};
  const logs=S.phoneLogs.filter(l=>l.chatId===chatId&&l.type==="call").slice().reverse();

  if(call)return (
    <div className="flex-1 flex flex-col items-center p-4 min-h-0">
      <Avatar ch={char} emo={ch.emotion} size={84}/>
      <div className="serif text-2xl mt-2">{char.name}</div>
      <div className="text-sm text-neutral-400">{call.status==="ringing"?t("ringing"):call.status==="missed"?t("missed"):`${String(Math.floor(sec/60)).padStart(2,"0")}:${String(sec%60).padStart(2,"0")}`}</div>
      <div className="flex-1 w-full overflow-y-auto my-3 space-y-2">
        {call.lines.map((l,i)=><div key={i} className={"text-sm rounded-2xl px-3 py-2 "+(l.who==="user"?"ml-10 text-right":"mr-10")} style={{background:l.who==="user"?"rgba(var(--gold-rgb),.18)":"rgba(255,255,255,.07)"}}>{l.text}</div>)}
        {wait&&<div className="text-xs dot text-neutral-400">…</div>}
      </div>
      {call.status==="live"&&<div className="flex gap-2 w-full mb-3"><input className="inp" value={inp} placeholder={t("say")} onChange={e=>setInp(e.target.value)} onKeyDown={e=>e.key==="Enter"&&say()}/><button className="btn on" onClick={say}>↑</button></div>}
      <button className="btn danger !px-6 !py-2" onClick={hang}>☎ {t("hangup")}</button>
    </div>
  );

  return (
    <>
      <div className="p-3"><button className="btn on w-full !py-2" onClick={dial}>📞 {t("call")} {char.name}</button></div>
      <div className="flex-1 overflow-y-auto px-3 space-y-2">
        {logs.map(l=><div key={l.id} className="flex justify-between text-sm glass rounded-xl px-3 py-2"><span style={{color:l.text==="missed"?"#e57368":"#ddd"}}>{l.text==="missed"?"↙ "+t("missed"):"↗ "+Math.floor(l.dur/60)+"m "+l.dur%60+"s"}</span><span className="text-xs text-neutral-500">{new Date(l.ts).toLocaleString([],{month:"short",day:"numeric",hour:"2-digit",minute:"2-digit"})}</span></div>)}
      </div>
    </>
  );
}

