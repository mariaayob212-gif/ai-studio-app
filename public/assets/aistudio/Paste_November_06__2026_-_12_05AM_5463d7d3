  const runAiChar=async()=>{
    if(!aiDesc.trim()||aiBusy)return;
    setAiBusy(true);
    try{
      const g=await aiBuildChar(aiDesc.trim());
      setF(prev=>({...prev,name:g.name||prev.name,tagline:g.tagline||prev.tagline,avatar:g.avatar||prev.avatar,ambient:g.ambient||prev.ambient,system_prompt:g.system_prompt||prev.system_prompt,greeting:g.greeting||prev.greeting,autoInit:false,initEmotion:normEmo(g.initEmotion)||"Calm",initMetrics:{affection:15,trust:15,obsession:10,tension:20,hostility:5,...(g.initMetrics||{})},schedule:Array.isArray(g.schedule)?g.schedule:(prev.schedule||[])}));
      setAiDesc("");
    }catch(e){notify(t("apiFail"))}
    setAiBusy(false);
  };

  const runAiSched=async()=>{
    if(!scDesc.trim()||scBusy)return;
    setScBusy(true);
    try{
      const arr=await aiBuildSchedule(scDesc.trim(),f.name);
      if(Array.isArray(arr))setF(prev=>({...prev,schedule:arr}));
      setScDesc("");
    }catch(e){notify(t("apiFail"))}
