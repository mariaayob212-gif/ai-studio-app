const send=async text=>{
  if(!text.trim()||gen)return;
  haptic(25);
  const {s,chat,char}=ctxOf();const lv=LEN[chat.len]??LEN[3];
  const um={id:uid(),role:"user",variants:[text],idx:0,ts:Date.now()},am={id:uid(),role:"assistant",variants:[""],idx:0,ts:Date.now()};
  mut(x=>{const c=x.chats.find(k=>k.id===chatId);c.messages.push(um,am);c.lastUserTs=Date.now();c.followUps=0});
  ABORT=new AbortController();setGen(am.id);
  const r=await llm(s.userSettings,{
    system:sys(char,{...chat,messages:[...chat.messages,um]},true),
    hist:histOf([...chat.messages,um]),
    max:lv.tok+THK,
    onChunk:tx=>setV(chatId,am.id,0,cut(tx)),
    local:()=>localMuse(char,text,chat.metrics)
  });
  await out(chatId,am.id,0,r,"");
  applyMeta(chatId,char.id,r.meta,r.memNote);
  setGen(null);
  summarize(chatId);
  autoLore(chatId);
  refreshOrBalance();
  if(r.err)notify(t("apiFail")+" ("+r.err.slice(0,50)+")");
};

