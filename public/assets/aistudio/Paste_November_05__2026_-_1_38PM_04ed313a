  const r=await llm(s.userSettings,{system:"You are an expert dark-romance & psychological roleplay character designer. Output raw JSON only.",hist:[{role:"user",text:prompt}],max:900,local:()=>({text:JSON.stringify({name:"Kaelen Vance",tagline:desc.slice(0,60),avatar:"🗡️",system_prompt:`You are Kaelen Vance. Context: ${desc}. Speak with sharp, deliberate intensity. You are a person, never an AI.`,greeting:`*Kaelen studies you from across the room, jaw tight.* "So you finally decided to show up."`,initEmotion:"Guarded",initMetrics:{affection:10,trust:10,obsession:25,tension:60,hostility:50},schedule:[{from:2,to:9,state:"asleep",label:"sleeping lightly"},{from:14,to:20,state:"busy",label:"handling operations"}]})})});
