      setAiDesc("");
    }catch(e){notify(t("apiFail"))}
    setAiBusy(false);
  };

  const runAiSched=async()=>{
    if(!scDesc.trim()||scBusy)return;
    setScBusy(true);
    try{
      const arr=await aiBuildSchedule(scDesc.trim(),f.name);
