      <button type="button" className="btn on w-full !py-1.5" disabled={aiBusy||!aiDesc.trim()} onClick={runAiChar}>{aiBusy?"…":t("aiGenChar")}</button>
    </div>

    <AvatarPicker v={f} set={p=>setF({...f,...p})}/>
    {[["name","name"],["tagline","tagline"]].map(([k,l])=><label key={k} className="block text-xs text-neutral-400">{t(l)}<input className="inp mt-1" value={f[k]} onChange={up(k)}/></label>)}
