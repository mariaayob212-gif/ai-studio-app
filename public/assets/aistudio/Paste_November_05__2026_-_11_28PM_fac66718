/* ---------- Key Obfuscation ---------- */
const SALT="velvet-obf-v1";
const encKey=s=>{if(!s||s.startsWith("obf:"))return s;try{const x=Array.from(s).map((c,i)=>String.fromCharCode(c.charCodeAt(0)^SALT.charCodeAt(i%SALT.length))).join("");return "obf:"+btoa(unescape(encodeURIComponent(x)))}catch(e){return s}};
const decKey=s=>{if(!s||!s.startsWith("obf:"))return s||"";try{const raw=decodeURIComponent(escape(atob(s.slice(4))));return Array.from(raw).map((c,i)=>String.fromCharCode(c.charCodeAt(0)^SALT.charCodeAt(i%SALT.length))).join("")}catch(e){return ""}};

/* ---------- Haptics & Web Audio Ambient Soundscape Synthesizer ---------- */
const haptic=(ms=35)=>{try{navigator.vibrate&&navigator.vibrate(ms)}catch(e){}};
const AMBIENT_MODES=["off","rain","hearth","jazz","library"];
class AmbientEngine{
  constructor(){this.ctx=null;this.mode="off";this.nodes=[];}
  stop(){
    this.nodes.forEach(n=>{try{n.stop?.();n.disconnect?.()}catch(e){}});
    this.nodes=[];this.mode="off";
  }
  play(mode){
    this.stop();if(!mode||mode==="off")return;
    try{
      const AC=window.AudioContext||window.webkitAudioContext;
      if(!this.ctx)this.ctx=new AC();
      if(this.ctx.state==="suspended")this.ctx.resume();
      this.mode=mode;
      const ctx=this.ctx,master=ctx.createGain();
      master.gain.value=0.14;master.connect(ctx.destination);
      this.nodes.push(master);

      const bufSize=ctx.sampleRate*2,buf=ctx.createBuffer(1,bufSize,ctx.sampleRate),data=buf.getChannelData(0);
      let lastOut=0;
      for(let i=0;i<bufSize;i++){const w=Math.random()*2-1;data[i]=(lastOut+(0.02*w))/1.02;lastOut=data[i];data[i]*=3.2;}
      const noise=ctx.createBufferSource();noise.buffer=buf;noise.loop=true;
      const filter=ctx.createBiquadFilter();
      filter.type=mode==="rain"?"bandpass":"lowpass";
      filter.frequency.value=mode==="rain"?950:mode==="hearth"?260:420;
      noise.connect(filter);filter.connect(master);noise.start();
      this.nodes.push(noise,filter);

      if(mode==="jazz"||mode==="library"){
        const osc=ctx.createOscillator(),og=ctx.createGain();
        osc.type="sine";osc.frequency.value=mode==="jazz"?110:73.42;
        og.gain.value=0.05;osc.connect(og);og.connect(master);osc.start();
        this.nodes.push(osc,og);
      }
    }catch(e){}
  }
}
const AMBIENT=new AmbientEngine();

/* ---------- V2 PNG Character Card Reader & Writer (tEXt 'chara' chunk + CRC32) ---------- */
const CRC_TABLE=(()=>{const t=new Uint32Array(256);for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=c&1?0xedb88320^(c>>>1):c>>>1;t[n]=c;}return t;})();
const crc32=(bytes)=>{let c=0xffffffff;for(let i=0;i<bytes.length;i++)c=CRC_TABLE[(c^bytes[i])&0xff]^(c>>>8);return (c^0xffffffff)>>>0;};

async function parsePngCharacterCard(file){
  const buf=await file.arrayBuffer(),u8=new Uint8Array(buf),dv=new DataView(buf);
  if(u8[0]!==0x89||u8[1]!==0x50||u8[2]!==0x4e||u8[3]!==0x47)throw new Error("Not a valid PNG");
  let off=8;
  while(off<u8.length){
    const len=dv.getUint32(off);
    const type=String.fromCharCode(u8[off+4],u8[off+5],u8[off+6],u8[off+7]);
    if(type==="tEXt"){
      const chunk=u8.subarray(off+8,off+8+len);
      let nul=0;while(nul<chunk.length&&chunk[nul]!==0)nul++;
      const kw=new TextDecoder().decode(chunk.subarray(0,nul));
      if(kw==="chara"||kw==="ccv3"){
        const b64=new TextDecoder().decode(chunk.subarray(nul+1));
        const jsonStr=decodeURIComponent(escape(atob(b64.trim())));
        const raw=JSON.parse(jsonStr);
        const d=raw.data||raw;
        const imgUrl=await fileToAvatar(file);
        return{
          name:d.name||"Unnamed",
          tagline:d.creator_notes||d.personality?.slice(0,80)||"Imported V2 Character Card",
          avatar:"🎭",
          img:imgUrl,
          system_prompt:[d.description,d.personality,d.scenario?`Scenario: ${d.scenario}`:"",d.system_prompt,d.mes_example?`Dialogue Examples:\n${d.mes_example}`:"","You are a person, never an AI."].filter(Boolean).join("\n\n"),
          greeting:d.first_mes||`*${d.name||"They"} looks at you intently.* "Hello."`
        };
      }
    }
    if(type==="IEND")break;
    off+=12+len;
  }
  throw new Error("No V2 character metadata found in PNG");
}

async function exportPngCharacterCard(char){
  const canvas=document.createElement("canvas");canvas.width=canvas.height=512;
  const ctx=canvas.getContext("2d");
  const grad=ctx.createLinearGradient(0,0,512,512);
  grad.addColorStop(0,"#09080d");grad.addColorStop(1,"#241522");
  ctx.fillStyle=grad;ctx.fillRect(0,0,512,512);
  if(char.img){
    await new Promise(res=>{const im=new Image();im.onload=()=>{ctx.drawImage(im,0,0,512,512);res()};im.onerror=res;im.src=char.img;});
  }else{
    ctx.font="180px serif";ctx.textAlign="center";ctx.textBaseline="middle";
    ctx.fillText(char.avatar||"🌹",256,220);
  }
  ctx.fillStyle="rgba(0,0,0,0.65)";ctx.fillRect(0,410,512,102);
  ctx.strokeStyle="#d4af37";ctx.lineWidth=4;ctx.strokeRect(8,8,496,496);
  ctx.fillStyle="#d4af37";ctx.font="bold 30px Georgia, serif";ctx.textAlign="center";
  ctx.fillText(char.name||"Character",256,450);
  ctx.fillStyle="#e2dcd0";ctx.font="16px sans-serif";
  ctx.fillText((char.tagline||"Velvet Studio V2 Card").slice(0,48),256,482);

  const blob=await new Promise(r=>canvas.toBlob(r,"image/png"));
  const u8=new Uint8Array(await blob.arrayBuffer());
  const v2Payload={
    spec:"chara_card_v2",spec_version:"2.0",
    data:{
      name:char.name,description:char.system_prompt,personality:char.tagline||"",
      scenario:"",first_mes:char.greeting||"",mes_example:"",
      creator_notes:char.tagline||"",system_prompt:char.system_prompt||"",
      extensions:{velvet:{schedule:char.schedule||[],initMetrics:char.initMetrics,initEmotion:char.initEmotion,ambient:char.ambient}}
    }
  };
  const b64=btoa(unescape(encodeURIComponent(JSON.stringify(v2Payload))));
  const kwBytes=new TextEncoder().encode("chara\0"+b64);
  const chunk=new Uint8Array(12+kwBytes.length);
  const dv=new DataView(chunk.buffer);
  dv.setUint32(0,kwBytes.length);
  chunk.set([0x74,0x45,0x58,0x74],4); // tEXt
  chunk.set(kwBytes,8);
  dv.setUint32(8+kwBytes.length,crc32(chunk.subarray(4,8+kwBytes.length)));

  const iendPos=u8.length-12;
  const out=new Uint8Array(u8.length+chunk.length);
  out.set(u8.subarray(0,iendPos),0);
  out.set(chunk,iendPos);
  out.set(u8.subarray(iendPos),iendPos+chunk.length);
  const a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob([out],{type:"image/png"}));
  a.download=(char.name||"character").replace(/\s+/g,"-")+".card.png";
  a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000);
}

