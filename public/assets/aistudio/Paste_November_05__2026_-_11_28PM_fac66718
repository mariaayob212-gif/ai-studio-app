const log=chat.messages.slice(-24).map(m=>(m.role==="user"?"USER: ":"CHARACTER: ")+strip(m.variants[m.idx]).replace(/\*/g,"")).join(NL);
const r=await llm(s.userSettings,{system:"Rewrite this character's core system_prompt. They have now reached high "+lab+" with the user. Evolve their personality organically based on the following chat history. Keep their name, identity, setting and the rule that they are a person, never an AI. Output ONLY the new system prompt text, with no commentary or code fences.",hist:[{role:"user",text:"CURRENT SYSTEM PROMPT:"+NL+base+NL+NL+"CHAT HISTORY:"+NL+log+NL+NL+"METRICS: "+MK.map(m=>m+" "+chat.metrics[m]).join(", ")}],max:700,local:()=>({text:base+"\n[PERSONA EVOLUTION] "+line})});
const nt=strip(r.text||"").replace(/^```\w*\s*|\s*```$/g,"").trim();
mut(x=>{const c=x.characters.find(y=>y.id===charId);if(!c)return;c.prev_prompt=c.system_prompt;c.system_prompt=nt.length>60?nt:c.system_prompt+"\n[PERSONA EVOLUTION] "+line})};

/* ---------- Generate Unlockable "Open When" Letter ---------- */
const generateLetter=async(cid,ms)=>{
  const s=SR.current,chat=s.chats.find(c=>c.id===cid),char=s.characters.find(c=>c.id===chat?.charId);
  if(!chat||!char)return;
  const log=chat.messages.slice(-18).map(m=>(m.role==="user"?"USER: ":"CHARACTER: ")+strip(m.variants[m.idx]).replace(/\*/g,"")).join(NL);
  const r=await llm(s.userSettings,{
    system:fill(char.system_prompt,char)+"\n"+fill(ms.prompt,char)+"\nWrite in first-person as a handwritten letter (120-200 words). No meta tags.",
    hist:[{role:"user",text:"SHARED MEMORY & RECENT SCENES:\n"+(chat.summary||"")+"\n"+log}],
    max:450,
    local:()=>({text:`My dearest,\n\nIf you are breaking the seal on this envelope, then we have crossed a threshold neither of us can undo. Every word we exchanged still lingers with me.\n\n— ${char.name}`})
  });
  const text=strip(r.text);
  mut(x=>{const c=x.chats.find(k=>k.id===cid);if(c){c.letters=c.letters||{};c.letters[ms.id]=text;}});
};