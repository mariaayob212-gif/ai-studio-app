function inferInitialState(char){
  if(char?.initMetrics&&!char.autoInit)return{metrics:{...char.initMetrics},emotion:char.initEmotion||"Calm"};
  const txt=((char?.tagline||"")+" "+(char?.system_prompt||"")+" "+(char?.greeting||"")).toLowerCase();
  const m={affection:15,trust:15,obsession:10,tension:20,hostility:5};
  let emo="Calm";
  if(/enem(y|ies)|rival|hat(e|red)|hostile|nemesis|kill|assassin|betray|prisoner|interrogat|captive|عدو|أعداء|يكره|كراهية|انتقام|خصم|سجين|تحقيق/.test(txt)){
    Object.assign(m,{affection:2,trust:3,obsession:25,tension:75,hostility:80});emo="Hostile";
  }else if(/predator|dangerous|ruthless|mafia|cartel|crime|stalker|possessive|controlling|dark|مفترس|خطير|مافيا|متملك|مهووس/.test(txt)){
    Object.assign(m,{affection:15,trust:10,obsession:45,tension:50,hostility:25});emo="Predatory";
  }else if(/secret|archivist|guarded|suspicious|cold|distant|stranger|detective|mystery|غامض|بارد|حذر|متشكك|غريب/.test(txt)){
    Object.assign(m,{affection:8,trust:5,obsession:10,tension:35,hostility:15});emo="Guarded";
  }else if(/lover|wife|husband|partner|devoted|gentle|sweet|childhood friend|حبيب|زوج|صديق|حنون|عاشق/.test(txt)){
    Object.assign(m,{affection:70,trust:65,obsession:35,tension:10,hostility:0});emo="Tender";
  }
  return{metrics:m,emotion:emo};
}

