/* ---------- Complete Tag & Bracket Sanitizer ---------- */
function parseBracketTelemetry(raw){
  const str=String(raw||"");
  const meta={};
  let thought="",memNote="";
  const em=str.match(/\[EMOTION\s*:\s*([^\]]+)\]/i);
  if(em){const ne=normEmo(em[1].trim());if(ne)meta.emotion=ne;}
  const im=str.match(/\[INNER_MONOLOGUE\s*:\s*"?([\s\S]*?)"?\s*\]/i);
  if(im)thought=im[1].trim();
  const hud=str.match(/\[HUD\s*:\s*([^\]]+)\]/i);
  if(hud){
    const hstr=hud[1];
    const mapKey={affection:"affection",love:"affection",trust:"trust",obsession:"obsession",tension:"tension",danger:"tension",dominance:"obsession",hostility:"hostility",anger:"hostility",hate:"hostility"};
    hstr.split(/[,;]/).forEach(part=>{
      const kv=part.match(/([a-zA-Z_]+)\s*[:=]\s*([+-]?\d+)/);
      if(kv){const k=mapKey[kv[1].toLowerCase()];if(k)meta[k]=(meta[k]||0)+Number(kv[2]);}
    });
  }
  const mem=str.match(/\[MEMORY\s*:\s*([^\]]+)\]/i);
  if(mem)memNote=mem[1].trim();
  return{meta:Object.keys(meta).length?meta:null,thought,memNote};
}

