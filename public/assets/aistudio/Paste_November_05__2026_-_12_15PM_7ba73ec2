<div className="flex justify-between items-center"><h2 className="serif text-2xl gold">🧠 {t("memory")}</h2><button className="btn" onClick={close}>✕</button></div>
<textarea rows={6} className="inp" value={ch.summary||""} placeholder={t("memEmpty")} onChange={e=>mut(s=>{s.chats.find(x=>x.id===chatId).summary=e.target.value})}/>
<button className="btn on" disabled={busy} onClick={async()=>{setBusy(true);await summarize(chatId,true);setBusy(false)}}>{busy?"…":t("summarize")}</button><button className="btn ml-2" onClick={()=>exportChat(chatId)}>⬇ {t("exportChat")}</button>
<h3 className="serif text-xl gold pt-2">📜 {t("lore")}</h3>{!lore.length&&<p className="text-xs text-neutral-500">{t("noLore")}</p>}
{lore.map(e=><div key={e.id} className="rounded-2xl p-3 text-xs space-y-1" style={{background:"rgba(255,255,255,.05)",opacity:e.on===false?.45:1}}><div className="gold">{e.keys}</div><div className="text-neutral-300">{e.content}</div>
<div className="flex gap-2"><button className="btn" onClick={()=>mut(s=>{const x=s.lorebook.find(l=>l.id===e.id);x.on=x.on===false})}>{e.on===false?"○":"●"}</button><button className="btn danger" onClick={()=>mut(s=>{s.lorebook=s.lorebook.filter(l=>l.id!==e.id)})}>{t("del")}</button></div></div>)}
<input className="inp" placeholder={t("loreKeys")} value={k} onChange={e=>setK(e.target.value)}/><textarea rows={3} className="inp" placeholder={t("loreText")} value={c} onChange={e=>setC(e.target.value)}/><button className="btn on" onClick={add}>＋ {t("addLore")}</button></div></div>}

/* ---------- Phone ---------- */
function PhoneModal(){const {setPhone,t,S,chatId}=useCtx();const pch=S.chats.find(c=>c.id===chatId),av=availability(pch,S.userSettings);const [tab,setTab]=useState("msg");
return <div className="fixed inset-0 z-[70] grid place-items-center p-3 bg-black/75" onClick={()=>setPhone(false)}><div onClick={e=>e.stopPropagation()} className="glass rise w-full max-w-sm flex flex-col overflow-hidden" style={{height:"min(720px,86vh)",borderRadius:36,borderWidth:3}}>
<div className="flex justify-center pt-2"><div className="w-20 h-1.5 rounded-full bg-white/15"/></div>
<div className="flex gap-2 justify-center p-2"><button className={"btn "+(tab==="msg"?"on":"")} onClick={()=>setTab("msg")}>💬 {t("messages")}</button><button className={"btn "+(tab==="call"?"on":"")} onClick={()=>setTab("call")}>📞 {t("calls")}</button><button className="btn" onClick={()=>setPhone(false)}>✕</button></div>
<div className="text-center text-[11px] pb-1" style={{color:av.busy?"#e57368":"#6fcf97"}}>● {av.busy?(av.label||t(av.why)):t("online")}</div><div className="flex-1 min-h-0 flex flex-col">{tab==="msg"?<MessagesApp/>:<CallsApp/>}</div></div></div>}

function MessagesApp(){const {S,chatId,typing,phoneSend,mut,t}=useCtx();const [v,setV]=useState(""),end=useRef(null);
const logs=S.phoneLogs.filter(l=>l.chatId===chatId&&l.type==="sms");
useEffect(()=>{end.current?.scrollIntoView({block:"end"});mut(s=>{const c=s.chats.find(x=>x.id===chatId);if(c)c.unread=0})},[logs.length,typing]);
const go=()=>{if(!v.trim())return;phoneSend(v.trim());setV("")};
return <><div className="flex-1 overflow-y-auto px-3 space-y-2">{logs.map(l=><div key={l.id} className={"flex "+(l.from==="user"?"justify-end":"justify-start")}><div className="rounded-2xl px-3 py-2 text-sm max-w-[80%]" style={l.from==="user"?{background:"#d4af37",color:"#111"}:{background:"rgba(255,255,255,.08)"}}>{l.text}<div className="text-[9px] opacity-60 mt-0.5">{new Date(l.ts).toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"})}</div></div></div>)}
{typing===chatId&&<div className="text-xs text-neutral-400 dot">{t("typing")}</div>}<div ref={end}/></div>
<div className="p-3 flex gap-2"><input className="inp" value={v} placeholder="iMessage" onChange={e=>setV(e.target.value)} onKeyDown={e=>e.key==="Enter"&&go()}/><button className="btn on" onClick={go}>↑</button></div></>}

function CallsApp(){const {S,chatId,t,mut,voice,SR}=useCtx();const [call,setCall]=useState(null),[sec,setSec]=useState(0),[inp,setInp]=useState(""),[wait,setWait]=useState(false);
const ch=S.chats.find(c=>c.id===chatId),char=S.characters.find(c=>c.id===ch.charId);
useEffect(()=>{if(call?.status!=="live")return;const i=setInterval(()=>setSec(x=>x+1),1000);return()=>clearInterval(i)},[call?.status]);
useEffect(()=>()=>{try{speechSynthesis.cancel()}catch(e){}},[]);
const log=(text,dur,tr)=>mut(s=>{s.phoneLogs.push({id:uid(),chatId,type:"call",from:"user",text,dur,tr,ts:Date.now()});bumpMeta(s,chatId,text==="completed"?{affection:2,trust:1,obsession:1,tension:-2}:{tension:1})});
const dial=()=>{setCall({status:"ringing",lines:[]});setSec(0);setTimeout(async()=>{const s=SR.current;if(availability(s.chats.find(c=>c.id===chatId),s.userSettings).busy){setCall({status:"missed",lines:[]});log("missed",0);return}
setCall({status:"live",lines:[]});const l=await voice(chatId,[],"(the call connects — answer it)");setCall(c=>c&&{...c,lines:[{who:"char",text:l}]})},2200)};
const say=async()=>{if(!inp.trim()||wait)return;const lines=[...call.lines,{who:"user",text:inp}];setCall({...call,lines});const q=inp;mut(s=>bumpMeta(s,chatId,moodOf(q)));setInp("");setWait(true);const l=await voice(chatId,lines,q);setWait(false);setCall(c=>c&&{...c,lines:[...lines,{who:"char",text:l}]})};
const hang=()=>{try{speechSynthesis.cancel()}catch(e){}if(call.status==="live")log("completed",sec,call.lines.map(l=>(l.who==="user"?"User: ":"You: ")+l.text).join(" | ").slice(0,400));setCall(null)};
const logs=S.phoneLogs.filter(l=>l.chatId===chatId&&l.type==="call").slice().reverse();
if(call)return <div className="flex-1 flex flex-col items-center p-4 min-h-0"><Avatar ch={char} emo={ch.emotion} size={84}/><div className="serif text-2xl mt-2">{char.name}</div>
<div className="text-sm text-neutral-400">{call.status==="ringing"?t("ringing"):call.status==="missed"?t("missed"):`${String(Math.floor(sec/60)).padStart(2,"0")}:${String(sec%60).padStart(2,"0")}`}</div>
<div className="flex-1 w-full overflow-y-auto my-3 space-y-2">{call.lines.map((l,i)=><div key={i} className={"text-sm rounded-2xl px-3 py-2 "+(l.who==="user"?"ml-10 text-right":"mr-10")} style={{background:l.who==="user"?"rgba(212,175,55,.15)":"rgba(255,255,255,.07)"}}>{l.text}</div>)}{wait&&<div className="text-xs dot text-neutral-400">…</div>}</div>
{call.status==="live"&&<div className="flex gap-2 w-full mb-3"><input className="inp" value={inp} placeholder={t("say")} onChange={e=>setInp(e.target.value)} onKeyDown={e=>e.key==="Enter"&&say()}/><button className="btn on" onClick={say}>↑</button></div>}
<button className="btn danger !px-6 !py-2" onClick={hang}>☎ {t("hangup")}</button></div>;
return <><div className="p-3"><button className="btn on w-full !py-2" onClick={dial}>📞 {t("call")} {char.name}</button></div>
<div className="flex-1 overflow-y-auto px-3 space-y-2">{logs.map(l=><div key={l.id} className="flex justify-between text-sm glass rounded-xl px-3 py-2"><span style={{color:l.text==="missed"?"#e57368":"#ddd"}}>{l.text==="missed"?"↙ "+t("missed"):"↗ "+Math.floor(l.dur/60)+"m "+l.dur%60+"s"}</span><span className="text-xs text-neutral-500">{new Date(l.ts).toLocaleString([],{month:"short",day:"numeric",hour:"2-digit",minute:"2-digit"})}</span></div>)}</div></>}

/* ---------- Settings ---------- */
const PLAB={gemini:"Gemini",openrouter:"OpenRouter",deepseek:"DeepSeek",ollama:"Ollama (local)",custom:"Custom (OpenAI-compatible)"};
const maskKey=k=>{const raw=decKey(k);return raw?raw.slice(0,4)+"•".repeat(12):"—"};
function SettingsView(){const {S,mut,setView,t,setConfirm,exportBackup,importBackup,setProfile,notify}=useCtx();const u=S.userSettings;
const set=(k,v)=>mut(s=>{s.userSettings[k]=k==="elevenKey"?encKey(v):v});
const keys=u.apiKeys||[];const [nk,setNk]=useState({name:"",key:"",provider:"gemini",model:PRE.gemini.m,baseUrl:""});
const addKey=()=>{const key=nk.key.trim();if(!key&&nk.provider!=="ollama"){notify(t("keyNeeded"));return}const e={id:uid(),name:nk.name.trim()||(PLAB[nk.provider]+" key"),key:encKey(key),provider:nk.provider,model:nk.model.trim(),baseUrl:nk.baseUrl.trim()};mut(s=>{s.userSettings.apiKeys=[...(s.userSettings.apiKeys||[]),e];if(!s.userSettings.activeKeyId)s.userSettings.activeKeyId=e.id});setNk({name:"",key:"",provider:nk.provider,model:nk.model,baseUrl:""});notify(t("keyAdded"))};
const delKey=k=>setConfirm({title:k.name,body:t("delKeyQ"),actions:[{label:t("del"),danger:true,fn:()=>mut(s=>{const L=(s.userSettings.apiKeys||[]).filter(x=>x.id!==k.id);s.userSettings.apiKeys=L;if(s.userSettings.activeKeyId===k.id)s.userSettings.activeKeyId=L[0]?.id||""})}]});
const F=({k,l,type="text",ph})=>{const val=k==="elevenKey"?decKey(u[k]):(u[k]??"");return <label className="block text-xs text-neutral-400">{l}<input type={type} placeholder={ph} className="inp mt-1" value={val} onChange={e=>set(k,type==="number"?Math.max(0,+e.target.value||0):e.target.value)}/></label>};
return <div className="max-w-md mx-auto px-4 pt-5 pb-16 rise space-y-4"><div className="flex items-center justify-between"><h1 className="serif text-3xl gold">{t("settings")}</h1><button className="btn" onClick={()=>setView("home")}>‹ {t("back")}</button></div>
<div className="glass rounded-3xl p-4 space-y-3"><div className="serif gold text-lg">🔐 {t("vault")}</div>
<div className="space-y-2">{keys.length===0&&<p className="text-[11px] text-neutral-500">{t("noKeys")}</p>}{keys.map(k=>{const on=k.id===u.activeKeyId;return <div key={k.id} className="rounded-2xl p-3 flex items-center gap-2 flex-wrap" style={{background:"rgba(255,255,255,.03)",border:on?"1.5px solid #d4af37":"1px solid rgba(255,255,255,.08)",boxShadow:on?"0 0 18px rgba(212,175,55,.18)":"none"}}><div className="flex-1 min-w-[130px]"><div className="text-sm truncate" style={{color:on?"#d4af37":undefined}}>{k.name}</div><div className="text-[11px] text-neutral-500 truncate">{PLAB[k.provider]||k.provider} · {k.model||(PRE[k.provider]||PRE.custom).m}</div><div className="text-[11px] text-neutral-400 font-mono">{maskKey(k.key)}</div></div><button className={"btn "+(on?"on":"")} onClick={()=>set("activeKeyId",k.id)}>{on?"● "+t("active"):"○ "+t("setActive")}</button><button className="btn danger" onClick={()=>delKey(k)}>{t("del")}</button></div>})}</div>
<div className="space-y-2 pt-3 border-t border-white/10"><div className="text-xs text-neutral-400">{t("addKey")}</div>
<input className="inp" placeholder={t("keyName")} value={nk.name} onChange={e=>setNk({...nk,name:e.target.value})}/>
<input type="password" autoComplete="off" className="inp" placeholder={t("keyStr")} value={nk.key} onChange={e=>setNk({...nk,key:e.target.value})}/>
<select className="inp" style={{colorScheme:"dark"}} value={nk.provider} onChange={e=>setNk({...nk,provider:e.target.value,model:(PRE[e.target.value]||PRE.custom).m})}>{Object.keys(PRE).map(p=><option key={p} value={p}>{PLAB[p]}</option>)}</select>
{nk.provider==="custom"&&<input className="inp" placeholder="https://…/v1" value={nk.baseUrl} onChange={e=>setNk({...nk,baseUrl:e.target.value})}/>}
<input className="inp" placeholder={t("model")} value={nk.model} onChange={e=>setNk({...nk,model:e.target.value})}/>
<button className="btn on w-full !py-2" onClick={addKey}>＋ {t("addKey")}</button></div>
<p className="text-[11px] text-neutral-500">{t("engine")}</p>{F({k:"elevenKey",l:t("elKey"),type:"password"})}</div>
<div className="glass rounded-3xl p-4 space-y-3"><div className="text-xs text-neutral-400">{t("language")}</div><div className="flex gap-2">{[["en","English"],["ar","العربية"]].map(([k,l])=><button key={k} className={"btn "+(u.language===k?"on":"")} onClick={()=>set("language",k)}>{l}</button>)}</div>
<div className="text-xs text-neutral-400">{t("timeMode")}</div><div className="flex gap-2 flex-wrap">{["auto","day","night"].map(k=><button key={k} className={"btn "+(u.timeMode===k?"on":"")} onClick={()=>set("timeMode",k)}>{t(k)}</button>)}</div>
{F({k:"followUpSec",l:t("followUp"),type:"number"})}</div>
<div className="glass rounded-3xl p-4 space-y-3"><button className="btn on w-full !py-2" onClick={()=>setProfile(true)}>👤 {t("myPersonas")}</button></div>
<div className="glass rounded-3xl p-4 space-y-3"><div className="serif gold text-lg">{t("genp")}</div>{[["temp",t("temp"),0,2,.1,1],["topP","Top-P",.1,1,.05,1]].map(([k,l,mn,mx,st,df])=><label key={k} className="block text-xs text-neutral-400">{l}: <b className="gold">{u[k]??df}</b><input type="range" min={mn} max={mx} step={st} value={u[k]??df} onChange={e=>set(k,+e.target.value)}/></label>)}</div>
<div className="glass rounded-3xl p-4 space-y-3"><div className="text-xs text-neutral-400">{t("backup")}</div><div className="flex gap-2 flex-wrap"><button className="btn on" onClick={exportBackup}>{t("exportB")}</button><label className="btn cursor-pointer">{t("importB")}<input type="file" accept="application/json,.json" className="hidden" onChange={importBackup}/></label></div></div>
<button className="btn danger" onClick={()=>setConfirm({title:t("reset"),body:t("resetQ"),actions:[{label:t("reset"),danger:true,fn:()=>mut(s=>{const n=seed();n.userSettings=s.userSettings;Object.assign(s,n)})}]})}>{t("reset")}</button></div>}

function Shell(){const {view,editing}=useCtx();return <><div key={view}>{view==="home"&&<HomeView/>}{view==="chat"&&<ChatView/>}{view==="settings"&&<SettingsView/>}</div><CharEditor key={editing?.id||"none"}/><ProfileModal/><Confirm/></>}
class Boundary extends React.Component{constructor(p){super(p);this.state={e:null}}static getDerivedStateFromError(e){return{e}}render(){return this.state.e?<div className="min-h-screen grid place-items-center p-6 text-center"><div className="glass rounded-3xl p-6 max-w-sm"><p className="serif text-2xl gold mb-2">Something broke</p><p className="text-xs text-neutral-400 mb-4 break-words">{String(this.state.e.message||this.state.e)}</p><button className="btn on" onClick={()=>this.setState({e:null})}>Retry</button></div></div>:this.props.children}}
ReactDOM.createRoot(document.getElementById("root")).render(<Boundary><Provider><Shell/></Provider></Boundary>);
</script></body></html>